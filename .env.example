# Copy to `.env` for local overrides: `cp .env.example .env` (Linux) or `Copy-Item .env.example .env` (Windows).
# Never write real secrets into this file. `.env` itself is ignored by git.

MULTIVERSE_ENV=local
MULTIVERSE_LOG_LEVEL=INFO
MULTIVERSE_DATA_DIR=var/data
MULTIVERSE_API_HOST=127.0.0.1
MULTIVERSE_API_PORT=8000

# Network downloads stay off until Stage 09-10 and an explicit decision by the owner.
MULTIVERSE_ALLOW_NETWORK_DOWNLOADS=false

# SEC requires a descriptive User-Agent with a contact email (Stage 10). Example:
# MULTIVERSE_SEC_USER_AGENT="MULTIVERSE research your-email@example.com"

# Personal FRED API key (Stage 13). Put it only into `.env`.
# MULTIVERSE_FRED_API_KEY=

# Paid compute is off: 0 means no cloud spending without the owner's approval.
MULTIVERSE_CLOUD_SPEND_LIMIT_USD=0
